# Public production host.
PUBLIC_DOMAIN=aistudio.upmini.app
LETSENCRYPT_EMAIL=admin@upmini.app

# Required for generation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Code generation models.
OPENAI_CODE_FAST_MODEL=gpt-5.2-codex
OPENAI_CODE_BALANCED_MODEL=gpt-5.2-codex
OPENAI_CODE_QUALITY_MODEL=gpt-5.2-codex
OPENAI_CODE_REPAIR_MODEL=gpt-5.2-codex
OPENAI_CODE_MAX_MODEL=gpt-5.2-codex
OPENAI_CODE_MINI_MODEL=gpt-5.2-codex

# Support/summarization model.
OPENAI_CODE_SUMMARY_MODEL=gpt-4.1-mini

# Preview runtime tuning.
PREVIEW_PORT_BASE=16000
PREVIEW_START_TIMEOUT_SEC=180
