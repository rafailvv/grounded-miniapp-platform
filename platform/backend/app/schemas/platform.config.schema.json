          "additionalProperties": {
            "type": "integer"
          },
          "title": "Max Selected By Mode",
          "type": "object"
        },
        "required_skills_by_mode": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Required Skills By Mode",
          "type": "object"
        },
        "activation_budget_by_mode": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "title": "Activation Budget By Mode",
          "type": "object"
        }
      },
      "title": "SkillActivationConfig",
      "type": "object"
    },
    "SkillRootConfig": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "default": true,
          "title": "System",
          "type": "boolean"
        },
        "repo": {
          "default": true,
          "title": "Repo",
          "type": "boolean"
        },
        "plugin": {
          "default": true,
          "title": "Plugin",
          "type": "boolean"
        },
        "user": {
          "default": true,
          "title": "User",
          "type": "boolean"
        }
      },
      "title": "SkillRootConfig",
      "type": "object"
    },
    "SlaConfig": {
      "additionalProperties": false,
      "properties": {
        "default_mode": {
          "default": "balanced",
          "title": "Default Mode",
          "type": "string"
        },
        "full_audit_modes": {
          "items": {
            "type": "string"
          },
          "title": "Full Audit Modes",
          "type": "array"
        },
        "visual_snapshot_modes": {
          "items": {
            "type": "string"
          },
          "title": "Visual Snapshot Modes",
          "type": "array"
        },
        "quality_like_modes": {
          "items": {
            "type": "string"
          },
          "title": "Quality Like Modes",
          "type": "array"
        },
        "second_queue": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Second Queue",
          "type": "array"
        },
        "compatibility": {
          "additionalProperties": true,
          "title": "Compatibility",
          "type": "object"
        }
      },
      "title": "SlaConfig",
      "type": "object"
    }
