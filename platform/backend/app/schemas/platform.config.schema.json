  "additionalProperties": false,
  "properties": {
    "schema": {
      "default": "grounded.platform_config.v1",
      "title": "Schema",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "generation_modes": {
      "additionalProperties": {
        "$ref": "#/$defs/GenerationModeConfig"
      },
      "title": "Generation Modes",
      "type": "object"
    },
    "checks": {
      "additionalProperties": {
        "$ref": "#/$defs/CheckConfig"
      },
      "title": "Checks",
      "type": "object"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelProviderConfig"
      },
      "title": "Providers",
      "type": "object"
    },
    "model_capabilities": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelCapabilityConfig"
      },
      "title": "Model Capabilities",
      "type": "object"
    },
    "model_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelProfileConfig"
      },
      "title": "Model Profiles",
      "type": "object"
    },
    "default_profile_by_mode": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Default Profile By Mode",
      "type": "object"
    },
    "skill_activation": {
      "$ref": "#/$defs/SkillActivationConfig"
    },
    "browser_proof": {
      "$ref": "#/$defs/BrowserProofConfig"
    },
    "sla": {
      "$ref": "#/$defs/SlaConfig"
    }
