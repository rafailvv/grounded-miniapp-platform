          "additionalProperties": true,
          "type": "object"
        },
        {
          "items": {},
          "type": "array"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "schema": {
      "default": "grounded.rpc.error.v2",
      "title": "Schema",
      "type": "string"
    }
  },
