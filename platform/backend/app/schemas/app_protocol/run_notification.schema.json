{
  "$defs": {
    "ProtocolRunState": {
      "additionalProperties": false,
      "properties": {
        "apply_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apply Status"
        },
        "current_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Stage"
        },
        "draft_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Draft Status"
        },
        "generation_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Mode"
        },
        "progress_percent": {
          "default": 0,
          "title": "Progress Percent",
          "type": "integer"
        },
        "refs": {
          "additionalProperties": true,
          "title": "Refs",
          "type": "object"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema": {
          "default": "grounded.app_protocol.run_state.v2",
          "title": "Schema",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "workspace_id",
        "status"
      ],
      "title": "ProtocolRunState",
      "type": "object"
    }
  },
  "$id": "https://grounded.local/schemas/app_protocol/run_notification.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "$ref": "#/$defs/ProtocolRunState"
    },
    "protocol_version": {
      "const": "v2",
      "default": "v2",
      "title": "Protocol Version",
      "type": "string"
    },
    "schema": {
      "default": "grounded.app_protocol.run_notification.v2",
      "title": "Schema",
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sequence"
    },
    "status": {
      "default": "running",
      "enum": [
        "queued",
        "started",
        "running",
        "waiting",
        "completed",
        "failed",
        "blocked",
        "cancelled",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject": {
      "const": "run",
      "default": "run",
      "title": "Subject",
      "type": "string"
    },
    "type": {
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "payload"
  ],
  "title": "RunNotification",
  "type": "object"
}
