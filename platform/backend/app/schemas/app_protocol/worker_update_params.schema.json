  "additionalProperties": false,
  "properties": {
    "after_sequence": {
      "default": 0,
      "title": "After Sequence",
      "type": "integer"
    },
    "limit": {
      "default": 500,
      "title": "Limit",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Id"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "WorkerUpdateParams",
  "type": "object"
}
