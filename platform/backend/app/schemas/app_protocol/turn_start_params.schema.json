{
  "$id": "https://grounded.local/schemas/app_protocol/turn_start_params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "generation_mode": {
      "default": "balanced",
      "title": "Generation Mode",
      "type": "string"
    },
    "intent": {
      "default": "auto",
      "title": "Intent",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mode": {
      "default": "generate",
      "title": "Mode",
      "type": "string"
    },
    "prompt": {
      "default": "",
      "title": "Prompt",
      "type": "string"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "workspace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "required": [
    "thread_id"
  ],
  "title": "TurnStartParams",
  "type": "object"
}
