{
  "$id": "https://grounded.local/schemas/app_protocol/rpc_idempotency.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "header": {
      "default": "Idempotency-Key",
      "title": "Header",
      "type": "string"
    },
    "key_field": {
      "default": "idempotency_key",
      "title": "Key Field",
      "type": "string"
    },
    "mode": {
      "default": "none",
      "enum": [
        "none",
        "optional",
        "recommended",
        "required"
      ],
      "title": "Mode",
      "type": "string"
    },
    "scope": {
      "default": "request",
      "enum": [
        "request",
        "workspace",
        "thread",
        "run",
        "global"
      ],
      "title": "Scope",
      "type": "string"
    }
  },
  "title": "RpcIdempotency",
  "type": "object"
}
