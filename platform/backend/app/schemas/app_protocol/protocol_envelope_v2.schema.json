{
  "$id": "https://grounded.local/schemas/app_protocol/protocol_envelope_v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "default": "system",
      "title": "Actor",
      "type": "string"
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "compatibility": {
      "additionalProperties": true,
      "title": "Compatibility",
      "type": "object"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Ref"
    },
    "payload_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload Sha256"
    },
    "previous_message_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Message Id"
    },
    "protocol_version": {
      "const": "v2",
      "default": "v2",
      "title": "Protocol Version",
      "type": "string"
    },
    "refs": {
      "additionalProperties": true,
      "title": "Refs",
      "type": "object"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema": {
      "default": "grounded.app_protocol.envelope.v2",
      "title": "Schema",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    },
    "status": {
      "enum": [
        "queued",
        "started",
        "running",
        "waiting",
        "completed",
        "failed",
        "blocked",
        "cancelled",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject": {
      "enum": [
        "run",
        "turn",
        "tool_call",
        "approval",
        "event",
        "worker_update"
      ],
      "title": "Subject",
      "type": "string"
    },
    "thread_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thread Id"
    },
    "tool_call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call Id"
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "type": {
      "title": "Type",
      "type": "string"
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Id"
    },
    "workspace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "required": [
    "message_id",
    "sequence",
    "subject",
    "type",
    "status",
    "created_at"
  ],
  "title": "ProtocolEnvelopeV2",
  "type": "object"
}
