{
  "$id": "https://grounded.local/schemas/app_protocol/browser_replay_scenario_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "console_logs": {
      "items": {
        "type": "string"
      },
      "title": "Console Logs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dom_snapshot_refs": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Dom Snapshot Refs",
      "type": "array"
    },
    "failed_step_context": {
      "additionalProperties": true,
      "title": "Failed Step Context",
      "type": "object"
    },
    "network_logs": {
      "items": {
        "type": "string"
      },
      "title": "Network Logs",
      "type": "array"
    },
    "playwright_spec": {
      "default": "",
      "title": "Playwright Spec",
      "type": "string"
    },
    "playwright_spec_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Playwright Spec Ref"
    },
    "replay_command_hint": {
      "default": "npx playwright test",
      "title": "Replay Command Hint",
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Role"
    },
    "route": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Route"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "schema": {
      "default": "grounded.browser_replay_scenario.v1",
      "title": "Schema",
      "type": "string"
    },
    "screenshot_refs": {
      "items": {
        "type": "string"
      },
      "title": "Screenshot Refs",
      "type": "array"
    },
    "status": {
      "default": "unknown",
      "enum": [
        "passed",
        "failed",
        "partial",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Steps",
      "type": "array"
    },
    "viewport": {
      "additionalProperties": true,
      "title": "Viewport",
      "type": "object"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "run_id",
    "scenario_id"
  ],
  "title": "BrowserReplayScenarioReport",
  "type": "object"
}
