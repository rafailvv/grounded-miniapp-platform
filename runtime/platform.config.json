{
  "schema": "grounded.platform_config.v1",
  "version": 1,
  "generation_modes": {
    "basic": {
      "enabled": true,
      "label": "Basic scaffold",
      "objective": "Small low-risk scaffold or exploratory edit with only static sanity checks.",
      "required_checks": ["changed_files_static"],
      "optional_checks": ["api_workflow_smoke"],
      "proof_requirements": ["static import/build sanity"],
      "final_gate": ["meaningful diff"],
      "context_policy": "tiny",
      "worker_policy": "serial",
      "max_repair_attempts": 1,
      "audit_level": "none",
      "output_style": "short",
      "completion_budget": {
        "time_limit_ms": 960000,
        "token_limit": 1200000,
        "turn_budget_cap": 120
      }
    },
    "fast": {
      "enabled": true,
      "label": "Fast happy path",
      "objective": "Ship one working happy path quickly with minimal but real product proof.",
      "required_checks": ["api_workflow_smoke", "browser_flow_smoke"],
      "optional_checks": ["changed_files_static", "generated_app_python_tests", "generated_app_js_tests"],
      "proof_requirements": ["one prompt-derived happy path", "persisted state marker", "single role/browser route proof"],
      "final_gate": ["meaningful product diff", "happy path browser proof"],
      "context_policy": "focused",
      "worker_policy": "serial",
      "max_repair_attempts": 2,
      "audit_level": "light",
      "output_style": "concise",
      "completion_budget": {
        "time_limit_ms": 960000,
        "token_limit": 1200000,
        "turn_budget_cap": 120
      }
    },
    "balanced": {
      "enabled": true,
      "label": "Balanced product proof",
      "objective": "Cover role flows, persistence, generated tests, and mobile usability.",
      "required_checks": ["api_workflow_smoke", "browser_flow_smoke", "generated_app_python_tests", "generated_app_js_tests"],
      "optional_checks": ["visual_regression", "prompt_completion_audit"],
      "proof_requirements": ["role coverage", "shared persistence", "mobile layout", "generated app tests"],
      "final_gate": ["requirement traceability", "prompt completion audit", "repair case sync"],
      "context_policy": "standard",
      "worker_policy": "serial with repair cases",
      "max_repair_attempts": 5,
      "audit_level": "standard",
      "output_style": "implementation_summary",
      "completion_budget": {
        "time_limit_ms": 1200000,
        "token_limit": 1200000,
        "turn_budget_cap": 180
      }
    },
    "quality": {
      "enabled": true,
      "label": "Quality browser + visual proof",
      "objective": "Deep generated-app proof with browser scenarios, analytics, edge states, and visual snapshots.",
      "required_checks": ["api_workflow_smoke", "browser_flow_smoke", "generated_app_python_tests", "generated_app_js_tests"],
      "optional_checks": ["visual_regression", "observability", "guardian_review"],
      "proof_requirements": ["browser proof", "analytics/observability signals", "edge states", "visual snapshots", "mobile overflow/overlap scan"],
      "final_gate": ["requirement traceability", "prompt completion audit", "visual regression report", "final review gate"],
      "context_policy": "broad",
      "worker_policy": "parallel owned branches when contract is ready",
      "max_repair_attempts": 6,
      "audit_level": "deep",
      "output_style": "proof_first",
      "completion_budget": {
        "time_limit_ms": 2400000,
        "token_limit": 2200000,
        "turn_budget_cap": 280
      }
    },
    "production": {
      "enabled": true,
      "label": "Production release gate",
      "objective": "Release-grade proof with security, export, docs, regression, and full audit evidence.",
      "required_checks": ["api_workflow_smoke", "browser_flow_smoke", "generated_app_python_tests", "generated_app_js_tests"],
      "optional_checks": ["visual_regression", "security_summary", "export_bundle", "documentation", "regression_suite", "observability"],
      "proof_requirements": ["full role regression", "security/privacy review", "exportable artifact", "operator docs", "visual regression", "full prompt audit"],
      "final_gate": ["security summary", "export proof", "docs proof", "regression proof", "prompt-to-artifact completion audit"],
      "context_policy": "release",
      "worker_policy": "parallel workers plus final release review",
      "max_repair_attempts": 8,
      "audit_level": "release",
      "output_style": "release_report",
      "completion_budget": {
        "time_limit_ms": 3600000,
        "token_limit": 3000000,
        "turn_budget_cap": 360
      }
    }
  },
  "checks": {
    "changed_files_static": {
      "label": "Changed files static analysis",
      "category": "static",
      "blocking": true,
      "proof_kind": "static_sanity",
      "required_for_modes": ["basic"],
      "diagnostic_contract": ["changed_files", "syntax_errors"],
      "repair_hint": "Fix syntax/import/static contract failures before running deeper proof."
    },
    "api_workflow_smoke": {
      "label": "API workflow smoke",
      "category": "api",
      "blocking": true,
      "proof_kind": "persistence",
      "required_for_modes": ["fast", "balanced", "quality", "production"],
      "diagnostic_contract": ["api_paths", "steps", "persisted_state_marker"],
      "repair_hint": "Persist prompt-derived state through FastAPI routes and prove it with create/list/update steps."
    },
    "browser_flow_smoke": {
      "label": "Browser role workflow smoke",
      "category": "browser",
      "blocking": true,
      "proof_kind": "ui_workflow",
      "required_for_modes": ["fast", "balanced", "quality", "production"],
      "diagnostic_contract": ["roles_checked", "ui_steps", "mobile_layout", "screenshots"],
      "repair_hint": "Run a mobile browser flow that exercises prompt-derived role actions and visible readback."
    },
    "generated_app_python_tests": {
      "label": "Generated Python acceptance tests",
      "category": "tests",
      "blocking": true,
      "proof_kind": "backend_regression",
      "required_for_modes": ["balanced", "quality", "production"],
      "diagnostic_contract": ["pytest_output", "acceptance_routes"],
      "repair_hint": "Update generated backend tests and application code together."
    },
    "generated_app_js_tests": {
      "label": "Generated JavaScript acceptance tests",
      "category": "tests",
      "blocking": true,
      "proof_kind": "frontend_regression",
      "required_for_modes": ["balanced", "quality", "production"],
      "diagnostic_contract": ["node_test_output", "role_pages"],
      "repair_hint": "Keep role UI selectors and generated browser tests aligned."
    },
    "visual_regression": {
      "label": "Visual regression",
      "category": "visual",
      "blocking": false,
      "proof_kind": "visual_snapshot",
      "required_for_modes": [],
      "diagnostic_contract": ["screenshots", "viewport", "diff_summary"],
      "repair_hint": "Compare mobile screenshots and fix overflow, overlap, or missing states."
    }
  },
  "providers": {
    "openai": {
      "label": "OpenAI",
      "enabled_env": "OPENAI_API_KEY",
      "base_url_env": "OPENAI_BASE_URL",
      "default_base_url": "https://api.openai.com/v1",
      "models": ["gpt-5.4-mini", "text-embedding-3-large"]
    }
  },
  "model_capabilities": {
    "gpt-5.4-mini": {
      "provider": "openai",
      "context_window": 1000000,
      "supports_tools": true,
      "supports_structured_output": true,
      "supports_reasoning": true,
      "cost_tier": "low",
      "roles": ["agent_turn", "code_edit", "repair", "summarize", "cheap_task"]
    },
    "text-embedding-3-large": {
      "provider": "openai",
      "context_window": 8191,
      "supports_tools": false,
      "supports_structured_output": false,
      "supports_reasoning": false,
      "cost_tier": "embedding",
      "roles": ["embedding"]
    }
  },
  "model_profiles": {
    "openai_code_fast": {
      "label": "OpenAI Code Fast",
      "provider": "openai",
      "description": "Default iterative coding profile tuned for lower cost while keeping solid general coding quality.",
      "routing": {
        "agent_turn": "gpt-5.4-mini",
        "code_edit": "gpt-5.4-mini",
        "repair": "gpt-5.4-mini",
        "summarize": "gpt-5.4-mini",
        "cheap_task": "gpt-5.4-mini"
      },
      "default": true,
      "fallbacks": {}
    },
    "research_balanced": {
      "label": "Research Balanced",
      "provider": "openai",
      "description": "Balanced profile for iterative code-agent generation and repair.",
      "routing": {
        "agent_turn": "gpt-5.4-mini",
        "code_edit": "gpt-5.4-mini",
        "repair": "gpt-5.4-mini",
        "summarize": "gpt-5.4-mini",
        "cheap_task": "gpt-5.4-mini"
      },
      "default": false,
      "fallbacks": {}
    },
    "openai_code_quality": {
      "label": "OpenAI Code Quality",
      "provider": "openai",
      "description": "Highest-confidence profile for iterative code-agent generation and repair.",
      "routing": {
        "agent_turn": "gpt-5.4-mini",
        "code_edit": "gpt-5.4-mini",
        "repair": "gpt-5.4-mini",
        "summarize": "gpt-5.4-mini",
        "cheap_task": "gpt-5.4-mini"
      },
      "default": false,
      "fallbacks": {}
    }
  },
  "default_profile_by_mode": {
    "basic": "openai_code_fast",
    "fast": "openai_code_fast",
    "balanced": "research_balanced",
    "quality": "openai_code_quality",
    "production": "openai_code_quality"
  },
  "skill_activation": {
    "enabled": true,
    "roots": {
      "system": true,
      "repo": true,
      "plugin": true,
      "user": true
    },
    "max_selected_by_mode": {
      "basic": 2,
      "fast": 4,
      "balanced": 6,
      "quality": 8,
      "production": 10
    },
    "required_skills_by_mode": {
      "fast": ["telegram-miniapp-product", "fastapi-persistence"],
      "balanced": ["telegram-miniapp-product", "fastapi-persistence", "browser-acceptance-proof"],
      "quality": ["telegram-miniapp-product", "fastapi-persistence", "browser-acceptance-proof", "mobile-ui-polish"],
      "production": ["telegram-miniapp-product", "fastapi-persistence", "browser-acceptance-proof", "mobile-ui-polish", "repair-failed-generation"]
    },
    "activation_budget_by_mode": {
      "basic": { "max_skills": 2, "max_body_chars": 1600, "max_total_body_chars": 2600 },
      "fast": { "max_skills": 4, "max_body_chars": 2200, "max_total_body_chars": 5000 },
      "balanced": { "max_skills": 6, "max_body_chars": 3000, "max_total_body_chars": 9000 },
      "quality": { "max_skills": 8, "max_body_chars": 3600, "max_total_body_chars": 14000 },
      "production": { "max_skills": 10, "max_body_chars": 4200, "max_total_body_chars": 18000 }
    }
  },
  "browser_proof": {
    "enabled": true,
    "required_modes": ["fast", "balanced", "quality", "production"],
    "screenshot_modes": ["quality", "production"],
    "require_ui_steps_modes": ["fast", "balanced", "quality", "production"],
    "require_persisted_marker_modes": ["fast", "balanced", "quality", "production"],
    "replay_artifacts": true,
    "default_mobile_viewport": {
      "width": 390,
      "height": 844
    }
  },
  "sla": {
    "default_mode": "balanced",
    "full_audit_modes": ["balanced", "quality", "production"],
    "visual_snapshot_modes": ["quality", "production"],
    "quality_like_modes": ["quality", "production"],
    "second_queue": [
      { "id": "doctor", "title": "/doctor platform + workspace diagnostics", "priority": 1, "status": "partially_available", "endpoint": "/doctor" },
      { "id": "cost", "title": "/cost generation cost accounting", "priority": 1, "status": "partially_available", "endpoint": "/system/observability" },
      { "id": "structured_diff", "title": "/diff structured patch review", "priority": 1, "status": "tool_available", "tool": "inspect_diff" },
      { "id": "review", "title": "/review code and product review for generated apps", "priority": 1, "status": "available", "endpoint": "/runs/{run_id}/review" },
      { "id": "context_view", "title": "Context view: what the agent actually saw", "priority": 2, "status": "partially_available", "endpoint": "/runs/{run_id}/context-pressure" },
      { "id": "resume_thread_lifecycle", "title": "/resume and thread lifecycle", "priority": 2, "status": "available", "endpoint": "/runs/{run_id}/resume" },
      { "id": "rewind_rollback", "title": "/rewind and rollback applied draft", "priority": 2, "status": "available", "endpoint": "/runs/{run_id}/rollback" },
      { "id": "prompt_suggestions", "title": "Prompt suggestions and speculation", "priority": 2, "status": "available", "endpoint": "/runs/{run_id}/prompt-suggestions" },
      { "id": "output_styles", "title": "Output styles for final responses", "priority": 3, "status": "planned" },
      { "id": "command_palette", "title": "Workbench keybinding and command palette improvements", "priority": 3, "status": "planned" },
      { "id": "ide_bridge", "title": "PyCharm/WebStorm IDE bridge", "priority": 4, "status": "conditional" },
      { "id": "remote_sessions", "title": "Remote sessions for remote generation runtime", "priority": 4, "status": "conditional" }
    ],
    "compatibility": {
      "basic": "kept for legacy low-proof scaffolds",
      "production": "additive mode; quality remains accepted and maps to deep proof"
    }
  }
}
